PROJECT_NAME=Enterprise Agent RAG
ENVIRONMENT=local
API_V1_PREFIX=/api/v1

POSTGRES_USER=agent
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=agent_rag
DATABASE_URL=postgresql+psycopg://agent:replace-with-local-password@postgres:5432/agent_rag

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

LOG_LEVEL=INFO
JSON_LOGS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
SECURITY_SCAN_ENABLED=true

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_BUCKET_NAME=agent-rag
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

MAX_UPLOAD_SIZE_MB=50
SUPPORTED_KB_FILE_EXTENSIONS=docx,doc,pdf,md

DASHSCOPE_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_CHAT_MODEL=qwen-plus
BAILIAN_VISION_MODEL=qwen-vl-plus
BAILIAN_EMBEDDING_MODEL=text-embedding-v4
BAILIAN_EMBEDDING_DIMENSIONS=1024
RAG_TOP_K=8
RAG_MAX_CONTEXT_TOKENS=3500
RAG_TEMPERATURE=0.2
AGENT_MAX_ITERATIONS=4
AGENT_MEMORY_WINDOW=12
AGENT_TOOL_RESULT_MAX_CHARS=16000
AGENT_REQUIRE_CITATIONS=true
MAX_CHAT_ATTACHMENT_SIZE_MB=20
SUPPORTED_CHAT_FILE_EXTENSIONS=docx,doc,pdf,md,txt
SUPPORTED_CHAT_IMAGE_EXTENSIONS=png,jpg,jpeg,webp
CHUNK_TARGET_TOKENS=700
CHUNK_OVERLAP_TOKENS=120
LIBREOFFICE_BINARY=soffice

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
